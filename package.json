{
	"name": "@codeeditorland/github-bot",
	"version": "0.0.1",
	"private": false,
	"description": "A GitHub bot for tauri-apps org to automate various tasks and intended to used only by tauri-apps org members.",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/TauriGitHubBot#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/TauriGitHubBot/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/TauriGitHubBot.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"scripts": {
		"build": "tsup src/index.ts --clean",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"start": "probot run ./dist/index.js",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"probot": "13.4.5"
	},
	"devDependencies": {
		"@octokit/rest": "21.1.1",
		"@playform/build": "0.2.3",
		"nock": "14.0.3",
		"tsup": "8.4.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
