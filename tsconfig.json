{
	"compilerOptions": {
		"baseUrl": "./",
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "node",
		"outDir": "Target",
		"resolveJsonModule": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src/**/*.ts",
		"src",
		"src",
		"src",
		"src",
		"src"
	]
}
